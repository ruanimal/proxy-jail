#!/bin/sh
# postinst for proxy-jail
#
# Allow only sudo-group members to run the installed command as root.
# The caller's application environment is opaque JSON, not root's environment.

set -e

SUDOERS_FILE="/etc/sudoers.d/proxy-jail"
PROXY_JAIL_BIN="/usr/bin/proxy-jail"

fail() {
    echo "proxy-jail postinst: $*" >&2
    exit 1
}

check_safe_metadata() {
    [ "$(stat -c '%u:%g' -- "$1")" = "0:0" ] ||
        fail "$1 must be owned by root:root"
    mode=$(stat -c '%a' -- "$1")
    [ "$((0$mode & 07022))" -eq 0 ] ||
        fail "$1 has unsafe permissions"
}

case "$1" in
    configure)
        # A trusted directory prevents unprivileged replacement between the
        # checks, reading the old policy, and the final rename. Never follow a
        # symlink (including a dangling one), or modify an unsafe existing file.
        sudoers_dir=${SUDOERS_FILE%/*}
        [ ! -L "$sudoers_dir" ] && [ -d "$sudoers_dir" ] ||
            fail "$sudoers_dir must be a real directory"
        check_safe_metadata "$sudoers_dir"
        [ ! -L "$SUDOERS_FILE" ] || fail "$SUDOERS_FILE must not be a symlink"
        if [ -e "$SUDOERS_FILE" ]; then
            [ -f "$SUDOERS_FILE" ] || fail "$SUDOERS_FILE must be a regular file"
            check_safe_metadata "$SUDOERS_FILE"
            [ "$(stat -c '%h' -- "$SUDOERS_FILE")" = 1 ] ||
                fail "$SUDOERS_FILE must not have multiple hard links"
        fi

        umask 077
        sudoers_tmp=$(mktemp "$SUDOERS_FILE.XXXXXX")
        trap 'rm -f -- "$sudoers_tmp"' 0
        trap 'exit 1' HUP INT TERM

        if [ -e "$SUDOERS_FILE" ]; then
            # Only these exact User_Specs were generated by older packages.
            # In particular, do not turn an administrator's user-specific or
            # otherwise customized policy into a grant to the entire sudo group.
            # Re-emit our two Defaults last so an old !env_reset cannot win.
            awk -v bin="$PROXY_JAIL_BIN" '
                BEGIN {
                    legacy["ALL ALL=(root) NOPASSWD: " bin] = 1
                    legacy["ALL ALL=(root) NOPASSWD: SETENV: " bin] = 1
                    legacy["%sudo ALL=(root) NOPASSWD: " bin] = 1
                    legacy["%sudo ALL=(root) NOPASSWD: SETENV: " bin] = 1
                    rule = "%sudo ALL=(root) NOPASSWD: NOSETENV: " bin
                    reset = "Defaults!" bin " env_reset"
                    keep = "Defaults!" bin " env_keep += \"PROXY_JAIL_APP_ENV\""
                }
                {
                    continuation = continued
                    continued = ($0 ~ /\\$/)
                    if (!continuation && $0 in legacy) print rule
                    else if (continuation || ($0 != reset && $0 != keep)) print
                }
            ' "$SUDOERS_FILE" > "$sudoers_tmp"
        else
            cat > "$sudoers_tmp" <<EOF
# Allow members of group sudo to execute only the installed proxy-jail command.
# NOSETENV forbids -E and environment assignments that bypass sudo filtering.
%sudo ALL=(root) NOPASSWD: NOSETENV: $PROXY_JAIL_BIN
EOF
        fi
        cat >> "$sudoers_tmp" <<EOF
Defaults!$PROXY_JAIL_BIN env_reset
Defaults!$PROXY_JAIL_BIN env_keep += "PROXY_JAIL_APP_ENV"
EOF

        # Validate a complete, correctly owned candidate before touching the old
        # file. The same-directory rename is atomic; every failure leaves the
        # original policy (or its absence on a new install) intact.
        chown 0:0 "$sudoers_tmp"
        chmod 0440 "$sudoers_tmp"
        /usr/sbin/visudo -c -f "$sudoers_tmp" >/dev/null 2>&1 ||
            fail "visudo rejected the candidate; $SUDOERS_FILE was not changed"
        mv -fT -- "$sudoers_tmp" "$SUDOERS_FILE"
        trap - 0 HUP INT TERM
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
